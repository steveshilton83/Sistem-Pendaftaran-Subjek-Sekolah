# ==============================================================================
# e-Agihan SMKTego - Environment Configuration Template
# Salin fail ini kepada .env dan sesuaikan nilai sebelum pelancaran produksi.
# ==============================================================================

# 1. PERSEKITARAN HOSTING / DEPLOYMENT
NODE_ENV=production
PORT=8089

# 2. MAKLUMAT SEKOLAH & PENYELARAS
SCHOOL_NAME="SMK TENGHILAN"
SCHOOL_SESSION="2026/2027"
COORDINATOR_NAME="Steve Shilton Ating"

# 3. KESELAMATAN & KOD KEBENARAN KHAS (ADMIN / OVERRIDE PIN)
# Digunakan oleh Penyelaras & GKMP untuk membatalkan pertindihan subjek secara manual
ADMIN_PIN=2026

# 4. PANGKALAN DATA AWAN (FIREBASE REALTIME DATABASE)
# Masukkan URL pangkalan data Firebase jika ingin mengaktifkan Cloud Sync secara automatik
# Contoh: https://e-agihan-smktego-default-rtdb.asia-southeast1.firebasedatabase.app
FIREBASE_DATABASE_URL=

# 5. URL ASAS PELAYAN API
# Kosongkan jika frontend dan backend dihoskan bersama di bawah domain/origin yang sama.
# Contoh jika API backend dihoskan di pelayan berasingan: https://api.smktego.edu.my
API_BASE_URL=

# ==============================================================================
# FRONTEND CLIENT VARIABLES (Untuk sokongan Vite / Vercel / Netlify / Cloudflare)
# Pembolehubah berawalan VITE_ dibaca secara terus oleh bundler moden
# ==============================================================================
VITE_ADMIN_PIN=2026
VITE_FIREBASE_DATABASE_URL=
VITE_API_BASE_URL=
VITE_SCHOOL_NAME="SMK TENGHILAN"
VITE_SCHOOL_SESSION="2026/2027"
VITE_COORDINATOR_NAME="Steve Shilton Ating"
